{
  "openapi": "3.0.3",
  "info": {
    "title": "CineSaaS API",
    "version": "1.0.0",
    "description": "Documentacao HTTP da v1 do backend SaaS multi-tenant para cinemas. Esta versao fecha o fluxo principal de auth, catalogo, salas, sessoes, assentos e reservas operacionais."
  },
  "servers": [
    {
      "url": "http://localhost:3333",
      "description": "Ambiente local"
    }
  ],
  "tags": [
    { "name": "Health", "description": "Healthcheck e disponibilidade" },
    { "name": "Auth", "description": "Login, refresh e logout" },
    { "name": "Tenants", "description": "Criacao inicial de tenant" },
    { "name": "Members", "description": "Memberships e RBAC" },
    { "name": "Movies", "description": "Catalogo interno e integracao externa" },
    { "name": "Rooms", "description": "Salas e layout de assentos" },
    { "name": "Sessions", "description": "Agenda operacional de sessoes" },
    { "name": "Session Seats", "description": "Mapa materializado de assentos por sessao" },
    { "name": "Reservations", "description": "Hold, confirmacao e cancelamento de reservas" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Healthcheck da aplicacao",
        "responses": {
          "200": {
            "description": "Aplicacao disponivel",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/tenants": {
      "post": {
        "tags": ["Tenants"],
        "summary": "Cria tenant e owner inicial",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTenantRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tenant criado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreateTenantResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Autentica usuario com email e senha",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthTokensResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Rotaciona refresh token e emite novo access token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshTokenRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Refresh concluido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthTokensResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Revoga refresh token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshTokenRequest" }
            }
          }
        },
        "responses": {
          "204": { "$ref": "#/components/responses/NoContent" },
          "400": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Retorna usuario autenticado no contexto do tenant",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TenantIdHeader" }],
        "responses": {
          "200": {
            "description": "Contexto autenticado do usuario",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericObject" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/protected/ping": {
      "get": {
        "tags": ["Auth"],
        "summary": "Valida JWT autenticado",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Token valido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericObject" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/protected/tenant-ping": {
      "get": {
        "tags": ["Auth"],
        "summary": "Valida contexto do tenant ativo",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TenantIdHeader" }],
        "responses": {
          "200": {
            "description": "Tenant valido para o usuario",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericObject" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/protected/admin-ping": {
      "get": {
        "tags": ["Auth"],
        "summary": "Valida role administrativa no tenant",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TenantIdHeader" }],
        "responses": {
          "200": {
            "description": "Role administrativa valida",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericObject" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/members": {
      "get": {
        "tags": ["Members"],
        "summary": "Lista membros do tenant",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TenantIdHeader" }],
        "responses": {
          "200": {
            "description": "Lista de memberships do tenant",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericArray" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "tags": ["Members"],
        "summary": "Adiciona membro ao tenant",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TenantIdHeader" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateMemberRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Membro criado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreateMemberResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/members/{userId}": {
      "delete": {
        "tags": ["Members"],
        "summary": "Remove membro do tenant",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TenantIdHeader" },
          { "$ref": "#/components/parameters/UserIdParam" }
        ],
        "responses": {
          "204": { "$ref": "#/components/responses/NoContent" },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/members/{userId}/role": {
      "patch": {
        "tags": ["Members"],
        "summary": "Atualiza role de um membro",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TenantIdHeader" },
          { "$ref": "#/components/parameters/UserIdParam" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateMemberRoleRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Role atualizada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericObject" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/movies/search": {
      "get": {
        "tags": ["Movies"],
        "summary": "Busca filmes em provider externo normalizado",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TenantIdHeader" },
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "minLength": 1 },
            "description": "Texto da busca"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1 },
            "description": "Pagina da busca"
          },
          {
            "name": "provider",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/MovieSourceProvider" },
            "description": "Provider externo"
          }
        ],
        "responses": {
          "200": {
            "description": "Filmes encontrados",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericObject" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/movies/import": {
      "post": {
        "tags": ["Movies"],
        "summary": "Importa snapshot de filme para o catalogo interno do tenant",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TenantIdHeader" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ImportMovieRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Importacao idempotente ou reaproveitada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericObject" }
              }
            }
          },
          "201": {
            "description": "Filme importado pela primeira vez",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericObject" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/movies": {
      "get": {
        "tags": ["Movies"],
        "summary": "Lista filmes internos do tenant",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TenantIdHeader" }],
        "responses": {
          "200": {
            "description": "Lista de filmes internos",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericArray" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/rooms": {
      "get": {
        "tags": ["Rooms"],
        "summary": "Lista salas do tenant",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TenantIdHeader" }],
        "responses": {
          "200": {
            "description": "Lista de salas",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericArray" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "tags": ["Rooms"],
        "summary": "Cria sala com layout de assentos",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TenantIdHeader" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateRoomRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sala criada com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericObject" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/rooms/{roomId}": {
      "get": {
        "tags": ["Rooms"],
        "summary": "Busca sala do tenant por id",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TenantIdHeader" },
          { "$ref": "#/components/parameters/RoomIdParam" }
        ],
        "responses": {
          "200": {
            "description": "Sala encontrada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericObject" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["Rooms"],
        "summary": "Atualiza nome e ou layout de uma sala",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TenantIdHeader" },
          { "$ref": "#/components/parameters/RoomIdParam" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateRoomRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sala atualizada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericObject" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/sessions": {
      "get": {
        "tags": ["Sessions"],
        "summary": "Lista sessoes do tenant",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TenantIdHeader" }],
        "responses": {
          "200": {
            "description": "Lista de sessoes",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericArray" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "tags": ["Sessions"],
        "summary": "Cria sessao vinculada a filme e sala",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TenantIdHeader" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateSessionRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sessao criada com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericObject" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/sessions/{sessionId}": {
      "get": {
        "tags": ["Sessions"],
        "summary": "Busca sessao do tenant por id",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TenantIdHeader" },
          { "$ref": "#/components/parameters/SessionIdParam" }
        ],
        "responses": {
          "200": {
            "description": "Sessao encontrada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericObject" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/sessions/{sessionId}/seats": {
      "get": {
        "tags": ["Session Seats"],
        "summary": "Le mapa materializado de assentos da sessao",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TenantIdHeader" },
          { "$ref": "#/components/parameters/SessionIdParam" }
        ],
        "responses": {
          "200": {
            "description": "Mapa e resumo de assentos da sessao",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericObject" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/sessions/{sessionId}/seats/{seatId}/block": {
      "patch": {
        "tags": ["Session Seats"],
        "summary": "Bloqueia assento disponivel",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TenantIdHeader" },
          { "$ref": "#/components/parameters/SessionIdParam" },
          { "$ref": "#/components/parameters/SeatIdParam" }
        ],
        "responses": {
          "200": {
            "description": "Assento bloqueado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericObject" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/sessions/{sessionId}/seats/{seatId}/unblock": {
      "patch": {
        "tags": ["Session Seats"],
        "summary": "Desbloqueia assento bloqueado",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TenantIdHeader" },
          { "$ref": "#/components/parameters/SessionIdParam" },
          { "$ref": "#/components/parameters/SeatIdParam" }
        ],
        "responses": {
          "200": {
            "description": "Assento desbloqueado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericObject" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/sessions/{sessionId}/reservations": {
      "post": {
        "tags": ["Reservations"],
        "summary": "Cria hold de reserva para assentos da sessao",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TenantIdHeader" },
          { "$ref": "#/components/parameters/SessionIdParam" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateReservationRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Hold criado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericObject" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/reservations/{reservationId}": {
      "get": {
        "tags": ["Reservations"],
        "summary": "Le reserva operacional",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TenantIdHeader" },
          { "$ref": "#/components/parameters/ReservationIdParam" }
        ],
        "responses": {
          "200": {
            "description": "Reserva encontrada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericObject" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/reservations/{reservationId}/confirm": {
      "post": {
        "tags": ["Reservations"],
        "summary": "Confirma reserva em hold",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TenantIdHeader" },
          { "$ref": "#/components/parameters/ReservationIdParam" }
        ],
        "responses": {
          "200": {
            "description": "Reserva confirmada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericObject" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/reservations/{reservationId}/cancel": {
      "post": {
        "tags": ["Reservations"],
        "summary": "Cancela reserva",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TenantIdHeader" },
          { "$ref": "#/components/parameters/ReservationIdParam" }
        ],
        "responses": {
          "200": {
            "description": "Reserva cancelada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericObject" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "TenantIdHeader": {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "description": "Tenant ativo da request",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "UserIdParam": {
        "name": "userId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "RoomIdParam": {
        "name": "roomId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "SessionIdParam": {
        "name": "sessionId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "SeatIdParam": {
        "name": "seatId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ReservationIdParam": {
        "name": "reservationId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "NoContent": {
        "description": "Operacao concluida sem corpo de resposta"
      },
      "ValidationError": {
        "description": "Payload, parametros ou query invalidos",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "Autenticacao invalida ou ausente",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "Usuario autenticado sem permissao no contexto atual",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "Recurso nao encontrado",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Conflict": {
        "description": "Conflito de regra de negocio ou de estado",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "schemas": {
      "GenericObject": {
        "type": "object",
        "additionalProperties": true
      },
      "GenericArray": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "example": true }
        },
        "required": ["ok"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Validation error" }
        },
        "required": ["message"]
      },
      "Role": {
        "type": "string",
        "enum": ["OWNER", "ADMIN", "STAFF", "VIEWER"]
      },
      "MovieSourceProvider": {
        "type": "string",
        "enum": ["TMDB"]
      },
      "RoomSeatType": {
        "type": "string",
        "enum": ["STANDARD"]
      },
      "CreateTenantRequest": {
        "type": "object",
        "required": ["tenantName", "tenantSlug", "ownerEmail", "ownerPassword"],
        "properties": {
          "tenantName": { "type": "string", "minLength": 2, "example": "Cinema Centro" },
          "tenantSlug": { "type": "string", "minLength": 2, "example": "cinema-centro" },
          "ownerEmail": { "type": "string", "format": "email", "example": "owner@cinema.com" },
          "ownerPassword": { "type": "string", "minLength": 6, "example": "12345678" }
        }
      },
      "CreateTenantResponse": {
        "type": "object",
        "required": ["tenantId", "userId", "membershipId"],
        "properties": {
          "tenantId": { "type": "string", "format": "uuid" },
          "userId": { "type": "string", "format": "uuid" },
          "membershipId": { "type": "string", "format": "uuid" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "owner@cinema.com" },
          "password": { "type": "string", "minLength": 1, "example": "12345678" }
        }
      },
      "RefreshTokenRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": { "type": "string", "minLength": 10, "example": "rt_opaque_token_example" }
        }
      },
      "AuthTokensResponse": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string", "example": "jwt.access.token" },
          "refreshToken": { "type": "string", "example": "rt_opaque_token_example" }
        },
        "required": ["accessToken", "refreshToken"],
        "additionalProperties": true
      },
      "CreateMemberRequest": {
        "type": "object",
        "required": ["email", "password", "role"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "staff@cinema.com" },
          "password": { "type": "string", "minLength": 8, "example": "12345678" },
          "role": { "$ref": "#/components/schemas/Role" }
        }
      },
      "CreateMemberResponse": {
        "type": "object",
        "required": ["userId", "membershipId", "role"],
        "properties": {
          "userId": { "type": "string", "format": "uuid" },
          "membershipId": { "type": "string", "format": "uuid" },
          "role": { "$ref": "#/components/schemas/Role" }
        }
      },
      "UpdateMemberRoleRequest": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": { "$ref": "#/components/schemas/Role" }
        }
      },
      "ImportMovieRequest": {
        "type": "object",
        "required": ["sourceProvider", "sourceMovieId"],
        "properties": {
          "sourceProvider": { "$ref": "#/components/schemas/MovieSourceProvider" },
          "sourceMovieId": { "type": "string", "minLength": 1, "example": "603692" }
        }
      },
      "RoomSeat": {
        "type": "object",
        "required": ["number", "type", "active"],
        "properties": {
          "number": { "type": "integer", "minimum": 1, "example": 1 },
          "type": { "$ref": "#/components/schemas/RoomSeatType" },
          "active": { "type": "boolean", "example": true }
        }
      },
      "RoomSeatRow": {
        "type": "object",
        "required": ["label", "seats"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 10, "example": "A" },
          "seats": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/RoomSeat" }
          }
        }
      },
      "RoomSeatLayout": {
        "type": "object",
        "required": ["rows"],
        "properties": {
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/RoomSeatRow" }
          }
        }
      },
      "CreateRoomRequest": {
        "type": "object",
        "required": ["name", "seatLayout"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120, "example": "Sala 1" },
          "seatLayout": { "$ref": "#/components/schemas/RoomSeatLayout" }
        }
      },
      "UpdateRoomRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120, "example": "Sala Premium" },
          "seatLayout": { "$ref": "#/components/schemas/RoomSeatLayout" }
        },
        "additionalProperties": false,
        "minProperties": 1
      },
      "CreateSessionRequest": {
        "type": "object",
        "required": ["movieId", "roomId", "startsAt", "endsAt"],
        "properties": {
          "movieId": { "type": "string", "format": "uuid" },
          "roomId": { "type": "string", "format": "uuid" },
          "startsAt": { "type": "string", "format": "date-time", "example": "2026-05-25T19:00:00.000Z" },
          "endsAt": { "type": "string", "format": "date-time", "example": "2026-05-25T21:00:00.000Z" }
        }
      },
      "CreateReservationRequest": {
        "type": "object",
        "required": ["seatIds"],
        "properties": {
          "seatIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    }
  }
}
