{
  "dependencies": {
    "@fastify/jwt": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.7.1",
    "pg": "^8.17.2",
    "pino": "^10.2.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.17",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.8",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "scripts": {
    "dev": "tsx watch -r tsconfig-paths/register src/http/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/src/http/server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "cross-env NODE_ENV=test vitest run",
    "test:cov": "vitest --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "cross-env NODE_ENV=test drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx -r tsconfig-paths/register src/shared/db/seed/index.ts"
  }
}
